DATABASE_URL="postgresql://user:password@localhost:5432/placement_test_portal"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
FRONTEND_URL="http://localhost:3000"
PORT=4000

# Optional — per-IP request caps (default 100/min global, 5/min on login).
# Raise these for exam-day scale (many students behind one campus NAT) or
# for load testing; leave unset for normal brute-force protection.
GLOBAL_THROTTLE_LIMIT=
AUTH_THROTTLE_LIMIT=

# Optional — password-reset emails just get logged to the console if these
# aren't set (see MailService). Fill in to actually send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@kristujayanti.com"
