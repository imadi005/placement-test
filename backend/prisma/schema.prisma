generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  coordinator
  admin
}

enum Batch {
  A
  B
  C
}

enum TestStatus {
  draft
  scheduled
  live
  ended
}

enum QuestionType {
  mcq
  short_answer
  numeric
  descriptive
  coding
}

enum AttemptStatus {
  in_progress
  submitted
  auto_submitted
  flagged
  pending_grading
  graded
}

enum ViolationType {
  tab_switch
  fullscreen_exit
  devtools_suspected
  copy_paste
  window_blur
}

// --- Identity & roles -------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  role                Role
  fullName            String    @map("full_name")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  mustChangePassword  Boolean   @default(true) @map("must_change_password")
  resetToken          String?   @unique @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  // First-login (and future 2FA-style) email OTP — separate from
  // resetToken/resetTokenExpiresAt, which represent the *link* a verified
  // OTP hands off to so the existing reset-password flow can finish the job.
  otpCodeHash  String?   @map("otp_code_hash")
  otpExpiresAt DateTime? @map("otp_expires_at")

  student       Student?
  auditLogs     AuditLog[]      @relation("actor")
  batchChanges  BatchHistory[]  @relation("changedBy")
  createdTests  Test[]          @relation("createdBy")
  gradedAnswers AttemptAnswer[] @relation("gradedBy")

  @@map("users")
}

model Student {
  userId          String @id @map("user_id")
  user            User   @relation(fields: [userId], references: [id])
  rollNo          String @unique @map("roll_no")
  batch           Batch
  section         String
  currentSemester Int    @map("current_semester")

  attempts     TestAttempt[]
  batchHistory BatchHistory[]

  @@map("students")
}

// --- Batch management (audited) ---------------------------------------

model BatchHistory {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  student       Student  @relation(fields: [studentId], references: [userId])
  oldBatch      Batch    @map("old_batch")
  newBatch      Batch    @map("new_batch")
  changedById   String   @map("changed_by")
  changedBy     User     @relation("changedBy", fields: [changedById], references: [id])
  reason        String?
  relatedTestId String?  @map("related_test_id")
  relatedTest   Test?    @relation(fields: [relatedTestId], references: [id])
  changedAt     DateTime @default(now()) @map("changed_at")

  @@map("batch_history")
}

// --- Tests & questions ---------------------------------------------------

model Test {
  id              String     @id @default(uuid())
  title           String
  batchScope      String     @map("batch_scope") // "A" | "B" | "C" | "ALL"
  durationMinutes Int        @map("duration_minutes")
  scheduledStart  DateTime?  @map("scheduled_start")
  status          TestStatus @default(draft)
  createdById     String     @map("created_by")
  createdBy       User       @relation("createdBy", fields: [createdById], references: [id])
  sourceFileUrl   String?    @map("source_file_url")
  approved        Boolean    @default(false)
  createdAt       DateTime   @default(now()) @map("created_at")

  questions    Question[]
  attempts     TestAttempt[]
  batchChanges BatchHistory[]

  @@map("tests")
}

model Question {
  id            String       @id @default(uuid())
  testId        String       @map("test_id")
  test          Test         @relation(fields: [testId], references: [id])
  questionText  String       @map("question_text")
  questionOrder Int          @map("question_order")
  marks         Decimal      @default(1)
  questionType  QuestionType @default(mcq) @map("question_type")
  modelAnswer   String?      @map("model_answer")
  rubricNotes   String?      @map("rubric_notes")

  options           QuestionOption[]
  answers           AttemptAnswer[]
  codingProblem     CodingProblem?
  codingSubmissions CodingSubmission[]

  @@map("questions")
}

// --- Coding rounds (LeetCode-style) --------------------------------------

model CodingProblem {
  id     String @id @default(uuid())
  // 1:1 with Question — a coding question's LeetCode-style config (problem
  // statement itself stays on Question.questionText; this is everything
  // specific to the judged/coding experience).
  questionId String   @unique @map("question_id")
  question   Question @relation(fields: [questionId], references: [id])

  constraints     String? // free-text: input/output format, limits, examples note
  timeLimitMs     Int      @default(2000) @map("time_limit_ms")
  memoryLimitMb   Int      @default(256) @map("memory_limit_mb")
  // Language ids the student may pick from — Judge0 language slugs
  // ("c", "cpp", "java", "python"), kept as plain strings so adding a new
  // supported language never needs a migration.
  allowedLanguages String[] @map("allowed_languages")
  // { [languageId]: starterSourceCode } — the FUNCTION STUB only (not a full
  // program) pre-filled into the editor when the student picks that
  // language, e.g. "def twoSum(nums, target):\n    pass".
  starterCode Json @default("{}") @map("starter_code")
  // LeetCode-style judging: the student implements just this function, the
  // judge calls it with each test case's args and compares the return
  // value — see backend/src/judge/harness/. functionName/returnType default
  // to "" only so this migration doesn't fail against pre-existing
  // stdin/stdout-era rows; every question authored from here on fills them.
  functionName String        @default("") @map("function_name")
  parameters   Json          @default("[]") // [{ name: string, type: ParamType }, ...]
  returnType   String        @default("") @map("return_type")

  testCases CodingTestCase[]

  @@map("coding_problems")
}

model CodingTestCase {
  id              String        @id @default(uuid())
  codingProblemId String        @map("coding_problem_id")
  codingProblem   CodingProblem @relation(fields: [codingProblemId], references: [id])
  // JSON array of argument values in CodingProblem.parameters order, e.g.
  // "[[2,7,11,15], 9]" for twoSum(nums, target) — NOT raw stdin text anymore.
  input String
  // JSON value of the expected return, e.g. "[0,1]" — compared structurally
  // (parsed + deep-equal), not as a literal string.
  expectedOutput String @map("expected_output")
  // Sample cases are shown to the student on the problem screen; hidden
  // ones are judged but their input/output never leaves the server.
  isSample   Boolean @default(false) @map("is_sample")
  points     Decimal @default(1)
  orderIndex Int     @map("order_index")

  @@map("coding_test_cases")
}

// One row per graded attempt at a coding question — written when the
// attempt is submitted (Phase 2: judged via Judge0 against every test
// case, sample and hidden). `results` holds the per-test-case verdicts for
// the coordinator's eyes only; the student only ever sees the aggregate
// score, same privacy rule as hidden test cases themselves.
model CodingSubmission {
  id          String      @id @default(uuid())
  attemptId   String      @map("attempt_id")
  attempt     TestAttempt @relation(fields: [attemptId], references: [id])
  questionId  String      @map("question_id")
  question    Question    @relation(fields: [questionId], references: [id])
  language    String
  sourceCode  String      @map("source_code")
  status      String // "accepted" | "wrong_answer" | "compile_error" | "runtime_error" | "time_limit_exceeded" | "judge_unavailable"
  score       Decimal     @default(0)
  maxScore    Decimal     @map("max_score")
  results     Json // [{ testCaseId, isSample, passed, actualOutput, stderr, status }]
  // Worst-case (max) time/memory across this submission's test cases —
  // the efficiency signal used to rank "most optimized" per-problem
  // winners on the leaderboard. Null when Judge0 never returned a metric
  // (e.g. compile error, judge unavailable).
  execTimeMs  Int?        @map("exec_time_ms")
  memoryKb    Int?        @map("memory_kb")
  judgedAt    DateTime    @default(now()) @map("judged_at")

  @@unique([attemptId, questionId])
  @@map("coding_submissions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id])
  optionText String   @map("option_text")
  isCorrect  Boolean  @map("is_correct")

  selectedIn AttemptAnswer[]

  @@map("question_options")
}

// --- Attempts, answers, violations -------------------------------------

model TestAttempt {
  id          String        @id @default(uuid())
  testId      String        @map("test_id")
  test        Test          @relation(fields: [testId], references: [id])
  studentId   String        @map("student_id")
  student     Student       @relation(fields: [studentId], references: [userId])
  startedAt   DateTime?     @map("started_at")
  submittedAt DateTime?     @map("submitted_at")
  status      AttemptStatus @default(in_progress)
  mcqScore    Decimal?      @map("mcq_score")
  finalScore  Decimal?      @map("final_score")

  answers           AttemptAnswer[]
  violations        Violation[]
  codingSubmissions CodingSubmission[]

  @@unique([testId, studentId])
  @@map("test_attempts")
}

model AttemptAnswer {
  id               String          @id @default(uuid())
  attemptId        String          @map("attempt_id")
  attempt          TestAttempt     @relation(fields: [attemptId], references: [id])
  questionId       String          @map("question_id")
  question         Question        @relation(fields: [questionId], references: [id])
  selectedOptionId String?         @map("selected_option_id")
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])
  freeTextAnswer   String?         @map("free_text_answer")
  // Coding questions only — the student's latest saved source + which
  // language it's in. Judged results (phase 2) will live on their own
  // CodingSubmission-style record; this is just the autosaved draft.
  submittedCode    String?         @map("submitted_code")
  codeLanguage     String?         @map("code_language")
  aiSuggestedMarks Decimal?        @map("ai_suggested_marks")
  marksAwarded     Decimal?        @map("marks_awarded")
  gradedById       String?         @map("graded_by")
  gradedBy         User?           @relation("gradedBy", fields: [gradedById], references: [id])
  gradedAt         DateTime?       @map("graded_at")
  answeredAt       DateTime?       @map("answered_at")
  markedForReview  Boolean         @default(false) @map("marked_for_review")

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

model Violation {
  id         String        @id @default(uuid())
  attemptId  String        @map("attempt_id")
  attempt    TestAttempt   @relation(fields: [attemptId], references: [id])
  type       ViolationType
  occurredAt DateTime      @default(now()) @map("occurred_at")
  meta       Json?

  @@map("violations")
}

// --- Audit ---------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actor      User     @relation("actor", fields: [actorId], references: [id])
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}
